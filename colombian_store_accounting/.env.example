APP_ENV=development
APP_URL=http://localhost:8000

# Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=aztec_accounting
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_SSL_CA=/path/to/ca.pem
DB_SSL_CERT=/path/to/client-cert.pem
DB_SSL_KEY=/path/to/client-key.pem

# Redis for Caching, Rate Limiting, JWT Revocation
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# JWT Secrets
JWT_SECRET_KEY='your-super-secret-key-for-access-tokens'
JWT_REFRESH_SECRET_KEY='your-other-secret-key-for-refresh-tokens'

# DIAN Service Credentials (load from vault in production)
DIAN_API_URL=https://api.dian.gov.co/v1
DIAN_PRIVATE_KEY_PATH=/path/to/your/private_key.pem
DIAN_PUBLIC_KEY_PATH=/path/to/dian_public_key.pem
DIAN_PINNED_PUBLIC_KEY="sha256//base64-encoded-pinned-key="

# Logging
LOG_LEVEL=DEBUG
