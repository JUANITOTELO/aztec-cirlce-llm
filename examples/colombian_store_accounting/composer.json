{
    "name": "aztec/colombian-accounting-system",
    "description": "POS and Accounting System for Colombian Businesses",
    "require": {
        "php": ">=8.1",
        "vlucas/phpdotenv": "^5.5",
        "monolog/monolog": "^3.3",
        "firebase/php-jwt": "^6.8",
        "predis/predis": "^2.1",
        "justinrainbow/json-schema": "^5.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.3"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    }
}